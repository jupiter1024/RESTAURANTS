{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bistroflow-worker",
  "main": "src/server/index.ts",
  "compatibility_date": "2024-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bistroflow-db",
      "database_id": "local-bistroflow-db"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "bistroflow-uploads"
    }
  ],
  "vars": {
    "JWT_SECRET": "bistroflow_local_dev_secret_override_with_wrangler_secret_in_prod"
  }
}
